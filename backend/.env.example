# Copy to .env and adjust. Every value can also be passed as an environment variable.
ENVIRONMENT=development
# Any PostgreSQL URL; plain postgresql:// ones from hosting providers work too.
DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5432/booking

# Required in production: a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=720
PASSWORD_RESET_TTL_MINUTES=30
# How long an invited customer has to register and accept a booking.
INVITATION_TTL_DAYS=7

# Must be true when served over HTTPS (always, in production).
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# "console" logs e-mails; "smtp" sends them.
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

RUN_BACKGROUND_JOBS=true
JOB_INTERVAL_SECONDS=60

# Booking assistant: see the README. One Groq key runs the model and the guards;
# without it the chat says it isn't set up.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# The model that talks (openai/gpt-oss-20b is lighter but invents names more often).
CHAT_MODEL=openai/gpt-oss-120b
CHAT_REASONING_EFFORT=low
# Only the last N customer turns are sent, to stay inside Groq's token limits.
CHAT_HISTORY_TURNS=8
GUARD_TOPIC_MODEL=openai/gpt-oss-20b
GUARD_INJECTION_MODEL=meta-llama/llama-prompt-guard-2-86m
GUARD_INJECTION_THRESHOLD=0.8
# Contacting the admin from the chat: the reply time customers are promised, and how often each can ask.
CHAT_HELP_RESPONSE_HOURS=6
CHAT_HELP_REQUESTS_PER_WEEK=3
# How long a booking the assistant made is held for the customer to confirm.
CHAT_HOLD_MINUTES=10
CHAT_MAX_OPEN_HOLDS=2
# Per-customer limits.
CHAT_MESSAGES_PER_MINUTE=10
CHAT_DAILY_MESSAGE_LIMIT=60
CHAT_DAILY_TOKEN_LIMIT=500000
# The throwaway database `python -m app.chat_eval` wipes and fills (its name must contain "eval" or "test").
# EVAL_DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5433/booking_eval
