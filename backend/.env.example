# Copy to .env and adjust. Every value can also be passed as an environment variable.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5432/booking

# Required in production: a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=720
PASSWORD_RESET_TTL_MINUTES=30

# Must be true when served over HTTPS (always, in production).
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# "console" logs e-mails; "smtp" sends them.
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

RUN_BACKGROUND_JOBS=true
JOB_INTERVAL_SECONDS=60
