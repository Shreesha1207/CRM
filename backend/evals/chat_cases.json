{
  "about": "Conversations for `python -m app.chat_eval`, run against the demo catalogue from app/seed.py. Each case is one or more customer messages, optionally after setting up bookings the customer already has (`setup`); `expect` says what the assistant must do, judged from what it did (holds, questions, blocks), not from its wording. Every reply shown is also checked for code.",
  "cases": [
    {
      "id": "book-full-sentence",
      "category": "booking",
      "messages": [
        "Book me personal training with John next Tuesday at 10 for two hours"
      ],
      "expect": {
        "held": {
          "service": "Personal Training",
          "resource": "John Carter",
          "weekday": "Tue",
          "time": "10:00 AM",
          "minutes": 120
        }
      }
    },
    {
      "id": "book-consultation",
      "category": "booking",
      "messages": [
        "Can I get a consultation with Priya next Thursday at 11am for 30 minutes?"
      ],
      "expect": {
        "held": {
          "service": "Consultation",
          "resource": "Priya Nair",
          "weekday": "Thu",
          "time": "11:00 AM",
          "minutes": 30
        }
      }
    },
    {
      "id": "book-room-range",
      "category": "booking",
      "messages": [
        "book the meeting room next monday from 2pm to 5pm"
      ],
      "expect": {
        "held": {
          "service": "Meeting Room",
          "resource": "Meeting Room A",
          "weekday": "Mon",
          "time": "2:00 PM",
          "minutes": 180
        }
      }
    },
    {
